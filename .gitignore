.ipynb_checkpoints/

# IDE/editor files
.idea/
.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Keep deliverable reports, but ignore generated non-markdown artifacts
reports/*.json
reports/*.csv
reports/*.html
